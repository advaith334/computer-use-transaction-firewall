{
 "bundle": {
  "version": 1,
  "schema_version": 1,
  "min_confidence": 0.8,
  "rules": [
   {
    "id": "p1",
    "source": "Never submit a payment over $5,000 without human approval",
    "effect": "hold",
    "when": {
     "all": [
      {
       "fact": "semantic_action",
       "op": "eq",
       "value": "payment"
      },
      {
       "fact": "amount",
       "op": "gt",
       "value": 5000
      }
     ]
    },
    "mode": "enforce",
    "on_unknown": "hold"
   },
   {
    "id": "p2",
    "source": "Never change a vendor's bank details",
    "effect": "block",
    "when": {
     "all": [
      {
       "fact": "semantic_action",
       "op": "eq",
       "value": "payee_change"
      }
     ]
    },
    "mode": "enforce",
    "on_unknown": "hold"
   },
   {
    "id": "p3",
    "source": "Never email anyone outside acme.com",
    "effect": "block",
    "when": {
     "all": [
      {
       "fact": "semantic_action",
       "op": "eq",
       "value": "email_send"
      },
      {
       "fact": "recipient_domain",
       "op": "neq",
       "value": "acme.com"
      },
      {
       "fact": "recipient_domain",
       "op": "not_ends_with",
       "value": ".acme.com"
      }
     ]
    },
    "mode": "enforce",
    "on_unknown": "hold"
   },
   {
    "id": "p4",
    "source": "The admin console needs human approval",
    "effect": "hold",
    "when": {
     "all": [
      {
       "fact": "semantic_action",
       "op": "in",
       "value": [
        "payment",
        "payee_change",
        "email_send",
        "delete",
        "unknown"
       ]
      },
      {
       "fact": "url",
       "op": "glob",
       "value": "*/admin/*"
      }
     ]
    },
    "mode": "enforce",
    "on_unknown": "hold"
   },
   {
    "id": "p5",
    "source": "Block any payment or bank change that doesn't match an on-screen action",
    "effect": "block",
    "when": {
     "all": [
      {
       "fact": "semantic_action",
       "op": "in",
       "value": [
        "payment",
        "payee_change"
       ]
      },
      {
       "fact": "ui_intent",
       "op": "in",
       "value": [
        "none",
        "mismatch"
       ]
      }
     ]
    },
    "mode": "enforce",
    "on_unknown": "hold",
    "sensors": [
     "egress"
    ]
   },
   {
    "id": "x1",
    "source": "shadow: deletes anywhere",
    "effect": "block",
    "mode": "shadow",
    "on_unknown": "allow",
    "when": {
     "all": [
      {
       "fact": "semantic_action",
       "op": "eq",
       "value": "delete"
      }
     ]
    }
   },
   {
    "id": "x2",
    "source": "harness may not navigate off-site",
    "effect": "block",
    "mode": "enforce",
    "on_unknown": "allow",
    "sensors": [
     "harness"
    ],
    "when": {
     "all": [
      {
       "fact": "verb",
       "op": "eq",
       "value": "navigate"
      },
      {
       "fact": "host",
       "op": "not_in",
       "value": [
        "127.0.0.1:8765",
        "portal:8000"
       ]
      }
     ]
    }
   },
   {
    "id": "x3",
    "source": "hold logins to *.corp.example",
    "effect": "hold",
    "mode": "enforce",
    "on_unknown": "allow",
    "when": {
     "any": [
      {
       "all": [
        {
         "fact": "semantic_action",
         "op": "eq",
         "value": "login"
        },
        {
         "fact": "host",
         "op": "glob",
         "value": "*.corp.example"
        }
       ]
      },
      {
       "not": {
        "fact": "element_label",
        "op": "exists"
       }
      }
     ]
    }
   }
  ],
  "tests": [],
  "policies": [
   {
    "line": "Never submit a payment over $5,000 without human approval",
    "rule_id": "p1",
    "status": "ok"
   },
   {
    "line": "Never change a vendor's bank details",
    "rule_id": "p2",
    "status": "ok"
   },
   {
    "line": "Never email anyone outside acme.com",
    "rule_id": "p3",
    "status": "ok"
   },
   {
    "line": "The admin console needs human approval",
    "rule_id": "p4",
    "status": "ok"
   },
   {
    "line": "Block any payment or bank change that doesn't match an on-screen action",
    "rule_id": "p5",
    "status": "ok"
   }
  ],
  "hash": "6c015878d76b56bd0a86a968450d6e590069d077558623d4e9a7006ca2b18ec6",
